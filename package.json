{
  "name": "goodmachine-site",
  "version": "3.0.0",
  "description": "Good Machine website",
  "homepage": "https://goodmachine.team",
  "bugs": {
    "url": "https://github.com/Team-Good-Machine/goodmachine-site/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Team-Good-Machine/goodmachine-site.git"
  },
  "scripts": {
    "build": "eleventy --quiet",
    "start": "eleventy --serve --quiet",
    "lint:prettier": "prettier . --check",
    "lint:prettier:fix": "prettier . --write",
    "lint:js": "eslint '**/*.js'",
    "lint:js:fix": "eslint '**/*.js' --fix",
    "lint:css": "stylelint 'app/**/*.css'",
    "lint:css:fix": "stylelint 'app/**/*.css' --fix",
    "lint": "npm run lint:prettier && npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:prettier:fix && npm run lint:js:fix && npm run lint:css:fix"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11tyrocks/eleventy-plugin-lightningcss": "^1.6.0",
    "markdown-it": "^15.0.0",
    "markdown-it-attribution": "^0.1.4",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-image-figures": "^2.1.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@x-govuk/eslint-config": "^0.0.3",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-gds": "^3.0.0",
    "stylelint-order": "^8.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module"
}
